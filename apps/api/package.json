{
  "name": "@job-analyzer/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint src --ext .ts",
    "analyze": "bun --filter @job-analyzer/shared build && nest build && node dist/apps/api/src/commands/analyze.js",
    "migration:run": "tsx data-source.ts",
    "migration:revert": "tsx -e \"import ds from './data-source.ts'; await ds.initialize(); await ds.undoLastMigration(); await ds.destroy();\""
  },
  "dependencies": {
    "@job-analyzer/shared": "workspace:*",
    "@nestjs/axios": "^3.1.0",
    "@nestjs/bullmq": "^10.2.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10",
    "axios": "^1.7.0",
    "bullmq": "^5.25.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.0",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.2",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/multer": "^1.4.12",
    "@types/pdf-parse": "^1.1.4",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/node": "^22.10.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
