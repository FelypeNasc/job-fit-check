{
  "name": "jobfitcheck",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "api": "bun --filter @jobfitcheck/api dev",
    "web": "bun --filter @jobfitcheck/web dev",
    "scrape": "bun --filter @jobfitcheck/scraper scrape",
    "analyze": "bun --filter @jobfitcheck/api analyze"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.7",
    "prettier": "^3.4.2"
  }
}
